# =============================================================================
# CSR Funding Intelligence — Environment Configuration
# =============================================================================
# Copy this to .env and adjust as needed. Every value has a sensible default;
# an empty .env (or none at all) works out of the box.

# --- Database (single-file SQLite, WAL mode) ---
# SQLITE_PATH=./data/csr-intel.db

# --- Web Search (OFF by default — search-free mode) ---
# Public search engines are captcha/rate-limit walled, so the pipeline runs on
# DIRECT sources only (Screener, IndiaCSR, Wikipedia, known URLs, official
# sites). To enable real search, configure a paid API key below AND set
# SEARCH_FREE_MODE=false.
# SEARCH_FREE_MODE=true
# SERPER_API_KEY=            # https://serper.dev
# BRAVE_SEARCH_API_KEY=      # https://brave.com/search/api/

# --- Puppeteer JS-render fallback ---
# Empty = puppeteer's own browser cache (dev default). Packaged builds set
# this automatically to the bundled Chromium.
# PUPPETEER_EXECUTABLE_PATH=

# --- Agent Concurrency ---
CONCURRENCY_DISCOVERY=2
CONCURRENCY_ENRICHMENT=2
CONCURRENCY_VERIFICATION=2
CONCURRENCY_DRIFT=2

# --- Rate Limiting ---
# Delays between fetch requests (ms). Lower = faster but risk 429s.
FETCH_DELAY_MS=1000
SEARCH_DELAY_MS=1500

# --- Scheduling (cron expressions) ---
CRON_DISCOVERY=0 6 * * *
CRON_ENRICHMENT=0 7 * * *
CRON_DRIFT=0 2 * * 0
CRON_QA_REPORT=0 8 * * 1
CRON_DAILY_REFRESH=0 10 * * *

# --- Logging ---
LOG_LEVEL=info

# --- Dashboard ---
DASHBOARD_PORT=3000

# --- Webhook (optional — Slack/Teams for review notifications) ---
# REVIEW_WEBHOOK_URL=https://hooks.slack.com/services/...
