# =============================================================================
# CSR Funding Intelligence System — Environment Configuration
# =============================================================================
# Copy this to .env and fill in your values.

# --- Database (Postgres — used for data + task queue) ---
# Docker compose auto-provides this inside the container.
# For local dev, point to your Postgres instance.
# Setup: docker compose up -d
# SQLite file path (default ./data/csr-intel.db)
# SQLITE_PATH=./data/csr-intel.db
# Legacy - only needed to re-run scripts/migrate-postgres-to-sqlite.ts
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/csr_intel

# --- LLM Provider (Ollama local model) ---
# Download Ollama: https://ollama.com/
# Then run: ollama pull llama3.1:8b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama

# --- Web Search ---
# The system uses a cascading search provider chain:
#   1. DuckDuckGo HTML scraper (keyless, primary — free and reliable)
#   2. Serper.dev (paid, most reliable if configured)
#   3. Brave Search API (free tier, recommended supplement)
#   4. Bing scraper (keyless fallback)
#   5. Google scraper (keyless, often blocked)
#
# PLUS: Known URL seeds for 30+ priority Indian companies (always works).

# Serper.dev Google Search API (optional)
# Sign up: https://serper.dev
SERPER_API_KEY=

# Brave Search API (optional — free tier: 2000 queries/month)
# Sign up: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# --- Agent Concurrency ---
# Lower values reduce search rate-limiting but slow discovery.
CONCURRENCY_DISCOVERY=2
CONCURRENCY_ENRICHMENT=2
CONCURRENCY_VERIFICATION=2
CONCURRENCY_DRIFT=2

# --- Rate Limiting ---
# Delays between fetch/search requests (ms). Lower = faster but risk 429s.
FETCH_DELAY_MS=1000
SEARCH_DELAY_MS=1500

# --- Scheduling (cron expressions) ---
CRON_DISCOVERY=0 6 * * *
CRON_ENRICHMENT=0 7 * * *
CRON_DRIFT=0 2 * * 0
CRON_QA_REPORT=0 8 * * 1
CRON_DAILY_REFRESH=0 10 * * *

# --- Logging ---
LOG_LEVEL=info

# --- Dashboard ---
DASHBOARD_PORT=3000

# --- Webhook (optional — Slack/Teams for review notifications) ---
# REVIEW_WEBHOOK_URL=https://hooks.slack.com/services/...
